# 接続先。ユーザー名でも URL でもよい。
#   TIKTOK_TARGET=@tiktok
#   TIKTOK_TARGET=https://www.tiktok.com/@tiktok/live
#   TIKTOK_TARGET=https://vt.tiktok.com/XXXXXXXX/   (共有用の短縮 URL。自動で展開します)
TIKTOK_TARGET=

# Euler Stream の署名サーバー API キー (任意)
# 未設定でも無料の共有レート制限で動作します。
# 頻繁に接続する / 複数ルームを見る場合は https://www.eulerstream.com で取得してください。
SIGN_API_KEY=

# 署名サーバーのベース URL (任意)
# 未設定なら tiktok-live-connector の既定値 https://api.eulerstream.com を使います。
# (https://tiktok.eulerstream.com も同じサービスです)
SIGN_API_URL=

# 配信者がまだライブしていない場合に、開始されるまで待機する秒数
# 0 = 待機しない (オフラインなら即終了)
WAIT_UNTIL_LIVE_SECONDS=0

# 表示ログレベル: debug | info | warn | error
LOG_LEVEL=info

# true にすると、各イベント行の先頭に時刻を付けます
TIMESTAMPS=false

# true にすると、購読しているすべてのイベントの生ペイロードも出力します
# (LOG_LEVEL=debug と併用してください)
DUMP_RAW=false
